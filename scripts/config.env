# Configuration for Multi-IP Multi-Port Setup
# Physical Network Interface
INTERFACE="enp4s0"

# Primary Host IP
HOST_PRIMARY_IP="192.168.0.107"

# Subnet Mask / CIDR
SUBNET_CIDR="24"

# 5 Dedicated IP Addresses for the 5 Flavors
# Note: 192.168.0.105 is occupied on this LAN, so 101, 102, 103, 104, 106 are used by default.
# You can change these to any free IPs on your subnet (e.g. 192.168.0.201 - 192.168.0.205).
IP_1="192.168.0.101"
IP_2="192.168.0.102"
IP_3="192.168.0.103"
IP_4="192.168.0.104"
IP_5="192.168.0.106"

# 5 Dedicated External Ports
PORT_1=9001
PORT_2=9002
PORT_3=9003
PORT_4=9004
PORT_5=9005

# Internal Localhost Ports
LOCAL_PORT_1=9001
LOCAL_PORT_2=9002
LOCAL_PORT_3=9003
LOCAL_PORT_4=9004
LOCAL_PORT_5=9005
